print(f"{len(certs)} certificates found")
for i in range(len(certs)):
    out = subprocess.run(['openssl','x509','-in',f'cert_{i}.pem','-noout','-subject','-issuer','-serial','-dates'],capture_output=True,text=True).stdout
    fp = subprocess.run(['openssl','x509','-in',f'cert_{i}.pem','-noout','-fingerprint','-sha256'],capture_output=True,text=True).stdout.strip()
    print(f"--- cert {i} ---")
    print(out.strip())
    print(fp)
